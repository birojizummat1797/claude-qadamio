# Qadam.io public website — environment variables.
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# Never put secrets (bot token, API keys, DB URLs) in NEXT_PUBLIC_ variables.

# Telegram bot that runs the diagnostic. Must be https://t.me/<username>.
# All "Diagnostikani boshlash" buttons use this (see lib/telegram.ts).
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/kelajakkailkqadam_bot

# Public origin of this website, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://qadam.io

# Pricing block is hidden until the business decision is made (D4).
NEXT_PUBLIC_SHOW_PRICING=false

# Analytics adapter: none | console. No third-party provider is wired yet (D8).
NEXT_PUBLIC_ANALYTICS=none

# Server-only. Base URL of the qadam-loyiha-deepseek backend; used at build time
# to read the public career taxonomy (B3). Unset = use the bundled snapshot.
QADAM_API_URL=
